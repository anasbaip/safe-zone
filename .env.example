# here are the environment variables for the user service. You can copy this file to .env and fill in the values.

JWT_SECRET=replace-this-with-a-strong-secret-key
JWT_EXPIRATION=90023345
SERVER_SSL_KEY_STORE_PASSWORD=replace-this-with-a-strong-secret-key

CLOUDINARY_CLOUD_NAME=replace-this
CLOUDINARY_API_KEY=replace-this
CLOUDINARY_API_SECRET=replace-this-zxQ

# Mongo root user — only used by the container itself and by healthchecks,
# no service connects with this user 
MONGO_ROOT_USERNAME=replace-this
MONGO_ROOT_PASSWORD=replace-this

# One scoped user per service database — each can only touch its own data.
PRODUCT_MONGO_DATABASE=product_service_db
PRODUCT_MONGO_USERNAME=product_service
PRODUCT_MONGO_PASSWORD=replace-this

MEDIA_MONGO_DATABASE=media_service_db
MEDIA_MONGO_USERNAME=media_service
MEDIA_MONGO_PASSWORD=replace-this

USER_MONGO_DATABASE=user_service_db
USER_MONGO_USERNAME=user_service
USER_MONGO_PASSWORD=replace-this

ORDER_MONGO_DATABASE=order_service_db
ORDER_MONGO_USERNAME=order_service
ORDER_MONGO_PASSWORD=replace-this
SONAR_DB_PASSWORD=replace-with-your-local-password